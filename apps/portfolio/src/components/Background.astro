---
import { profile, skillGroups, training } from '../content/profile';
---
<section class="background-section" id="background" aria-labelledby="background-heading">
  <div class="section-heading">
    <h2 id="background-heading">Academic background <span>&amp; INTERESTS</span></h2>
    <p>Learning through implementation and evaluation.</p>
  </div>
  <div class="background-intro">
    <h3>Applied ML,<br />careful <em>evaluation.</em></h3>
    <div>
      <p>My full name is {profile.fullName}. I’m a final-year Computer Science undergraduate working on applied machine learning and computer vision projects.</p>
      <p>My academic interests are applied machine learning, model evaluation, and interactive vision systems: how models behave beyond a training set, and how perception supports useful interaction.</p>
    </div>
  </div>
  <div class="skills-grid" aria-label="Technical skills">
    {skillGroups.map((group, index) => (
      <article class="skill-group">
        <span class="eyebrow">0{index + 1} / {group.evidence}</span>
        <h3>{group.name}</h3>
        <p>{group.detail}</p>
        <p class="skill-tools">{group.tools}</p>
      </article>
    ))}
  </div>
  <div class="learning-layout">
    <section class="education-block" aria-labelledby="education-heading">
      <p class="eyebrow">EDUCATION</p>
      <h3 id="education-heading">B.Sc. in Computer Science</h3>
      <p>Modern Academy for Computer Science and Management Technology, Maadi, Cairo, Egypt</p>
      <p class="education-period">2023–2027 · Expected graduation 2027</p>
      <p>Language of instruction: English.</p>
      <p>Relevant coursework: Linear Algebra, Calculus, Probability &amp; Statistics.</p>
      <p>Languages: Arabic — Native; English — Proficient in academic and technical communication.</p>
      <p>Education, training and languages reflect my current CV.</p>
    </section>
    <section class="training-block" aria-labelledby="training-heading">
      <h3 id="training-heading">Training &amp; professional development</h3>
      <ul class="training-list">
        {training.map((item) => (
          <li>
            <div><h4>{item.program}</h4><p>{item.organization}</p>{item.certificate && <a class="text-link" href={item.certificate} target="_blank" rel="noopener noreferrer" aria-label={`View ${item.organization} certificate`}>View certificate <span aria-hidden="true">↗</span></a>}</div>
            {item.period && <span class="training-period">{item.period}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</section>
