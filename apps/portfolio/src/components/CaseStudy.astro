---
import type { ProjectContent } from '../content/projects';
import { profile } from '../content/profile';

interface Props {
  project: ProjectContent;
}

const { project } = Astro.props;
const solutionOffset = project.solution ? 1 : 0;
const contributionOffset = project.contribution ? 1 : 0;
const sectionIndex = (value: number) => String(value).padStart(2, '0');
---

<article class="case-study">
  <a class="back-link" href="/#selected-work">
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M19 12H5m5-5-5 5 5 5"></path></svg>
    Back to work
  </a>

  <header class="case-hero">
    <div class="case-heading">
      <p class="eyebrow">{project.domain.toUpperCase()}</p>
      <h1>{project.name}</h1>
      <p class="case-deck">{project.distinction}</p>
      <div class="project-actions case-hero-actions">
        {project.demoAvailable && (
          <a class="button button-primary demo-launch" href={`#demo=${project.slug}`} data-demo-trigger={project.slug}>
            Try {project.name} demo
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
          </a>
        )}
        <a class="button button-secondary" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">
          View repository
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg>
        </a>
      </div>
    </div>
    <dl class="case-meta">
      <div><dt>Scope</dt><dd>{project.summary}</dd></div>
      {project.role && <div><dt>Role</dt><dd>{project.role}</dd></div>}
      <div><dt>Technology</dt><dd>{project.stack.join(' · ')}</dd></div>
    </dl>
  </header>

  {project.demoAvailable && <aside class="demo-status case-top-demo" aria-labelledby="demo-status-heading">
    <p class="eyebrow">{project.demoAvailable ? 'INTERACTIVE VIEW · SAMPLE DATA' : 'INTERACTIVE VIEW · NOT YET AVAILABLE'}</p>
    <h2 id="demo-status-heading">A bounded sample-data scenario</h2>
    <p>{project.demoSummary}</p>
    {project.demoAvailable && (
      <noscript>
        <p class="demo-noscript">The interactive sample needs JavaScript. Everything below describes the same scenario without it.</p>
      </noscript>
    )}
  </aside>}

  {project.media?.map((media) => (
    <figure class="case-capture">
      <img
        src={media.src}
        width={media.width}
        height={media.height}
        alt={media.alt}
        loading="eager"
        decoding="async"
      />
      <figcaption>{media.caption}</figcaption>
    </figure>
  ))}

  <figure class="system-diagram" aria-labelledby={`${project.slug}-diagram-title`}>
    <div class="diagram-label">
      <span class="eyebrow">SYSTEM FLOW DIAGRAM</span>
      <p id={`${project.slug}-diagram-title`}>{project.name} · documented structure</p>
    </div>
    <ol>
      {project.flow.map((step, index) => (
        <li>
          <span>0{index + 1}</span>
          <strong>{step}</strong>
        </li>
      ))}
    </ol>
    <figcaption>Explanatory diagram based on the project documentation and source.</figcaption>
  </figure>

  <div class="case-body">
    <section class="case-section case-problem" aria-labelledby="problem-heading">
      <p class="section-index">01</p>
      <div>
        <h2 id="problem-heading">The problem</h2>
        <p>{project.problem}</p>
      </div>
    </section>

    {project.solution && (
      <section class="case-section" aria-labelledby="solution-heading">
        <p class="section-index">02</p>
        <div>
          <h2 id="solution-heading">The solution</h2>
          <p>{project.solution}</p>
        </div>
      </section>
    )}

    {project.contribution && (
      <section class="case-section" aria-labelledby="contribution-heading">
        <p class="section-index">{sectionIndex(2 + solutionOffset)}</p>
        <div>
          <h2 id="contribution-heading">My contribution</h2>
          <p>{project.contribution}</p>
        </div>
      </section>
    )}

    <section class="case-section" aria-labelledby="capabilities-heading">
      <p class="section-index">{sectionIndex(2 + solutionOffset + contributionOffset)}</p>
      <div>
        <h2 id="capabilities-heading">Selected capabilities</h2>
        <div class="capability-list">
          {project.capabilities.map((capability) => (
            <div>
              <h3>{capability.label}</h3>
              <p>{capability.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="case-section" aria-labelledby="decisions-heading">
      <p class="section-index">{sectionIndex(3 + solutionOffset + contributionOffset)}</p>
      <div>
        <h2 id="decisions-heading">Engineering approach</h2>
        <div class="decision-list">
          {project.decisions.map((decision) => (
            <article>
              <h3>{decision.title}</h3>
              <p>{decision.detail}</p>
              <p class="tradeoff"><span>Tradeoff</span>{decision.tradeoff}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {project.details?.map((section, index) => (
      <section class="case-section" aria-labelledby={`${section.id}-heading`}>
        <p class="section-index">{sectionIndex(4 + solutionOffset + contributionOffset + index)}</p>
        <div>
          <h2 id={`${section.id}-heading`}>{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    ))}
  </div>

  {!project.demoAvailable && (
    <aside class="project-scope" aria-labelledby="project-scope-heading">
      <p class="eyebrow">CONTEXT &amp; LIMITS</p>
      <h2 id="project-scope-heading">Project scope</h2>
      <p>{project.demoSummary}</p>
    </aside>
  )}

  <aside class="case-next" aria-label="Project links">
    <div>
      <p class="eyebrow">SOURCE &amp; NEXT STEP</p>
      <h2>Inspect the source or start a conversation.</h2>
    </div>
    <div class="case-actions">
      <a class="button button-primary" href={`mailto:${profile.email}`}>Email {profile.firstName}</a>
      <a class="button button-secondary" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">
        View repository
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg>
      </a>
      {profile.cvUrl && <a class="text-link" href={profile.cvUrl} download>Download CV</a>}
    </div>
  </aside>
</article>
