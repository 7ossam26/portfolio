---
import { profile } from '../content/profile';
---
<section class="studio-hero" aria-labelledby="studio-heading">
  <div class="hero-main">
    <p class="eyebrow"><span class="small-rule"></span> APPLIED MACHINE LEARNING · COMPUTER VISION</p>
    <h1 id="studio-heading">
      <span>From data</span>
      <span>to <em>intelligent</em></span>
      <span><em>systems.</em></span>
    </h1>
  </div>
  <div class="hero-aside">
    <p class="hero-intro">I’m {profile.firstName}, a final-year Computer Science undergraduate focused on <strong>applied machine learning and computer vision.</strong> I build interactive systems and study how models perform.</p>
    <div class="hero-links">
      <a class="button button-primary" href="#selected-work">
        Explore my work
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 4v16m-6-6 6 6 6-6"></path></svg>
      </a>
      {profile.cvUrl ? <a class="button button-secondary" href={profile.cvUrl} download>Download CV <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5"></path></svg></a> : <a class="button button-secondary" href="#background">My background <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"></path></svg></a>}
    </div>
    <p class="location">Based in {profile.location} · Computer Science, Modern Academy</p>
  </div>
</section>
