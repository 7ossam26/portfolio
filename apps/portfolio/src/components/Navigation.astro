---
import { profile } from '../content/profile';
import { projects } from '../content/projects';
---
<header class="studio-nav">
  <a class="identity" href="/" aria-label={`${profile.name} home`}>
    <span class="wordmark" aria-hidden="true">{profile.initials}<span>.</span></span>
    <span class="identity-name">{profile.name}<span>{profile.title}</span></span>
  </a>
  <nav aria-label="Main navigation">
    <a href="/#selected-work">Selected work <span>{String(projects.length).padStart(2, '0')}</span></a>
    <a href="/#background">Background</a>
    <a class="nav-contact" href={`mailto:${profile.email}`}>
      Get in touch
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg>
    </a>
  </nav>
</header>
