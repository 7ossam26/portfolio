---
import type { ProjectContent } from '../content/projects';
interface Props { project: ProjectContent; compact?: boolean; }
const { project, compact = false } = Astro.props;
---
<figure class:list={['project-diagram', compact && 'project-diagram-compact']} aria-label={`${project.name} architecture diagram`}>
  <div class="project-diagram-heading">
    <span class="eyebrow">PROJECT ARCHITECTURE</span>
    <p>{project.name}</p>
  </div>
  <ol>
    {project.flow.map((step, index) => (
      <li><span class="workflow-index">{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 4v16m-5-5 5 5 5-5"></path></svg></li>
    ))}
  </ol>
  <figcaption>Explanatory diagram of the project’s documented structure.</figcaption>
</figure>
