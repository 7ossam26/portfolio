---
import type { ProjectContent } from '../content/projects';

interface Props {
  projects: readonly ProjectContent[];
}

const { projects } = Astro.props;
---

<div class="project-list" aria-label="More selected work">
  {projects.map((project, index) => (
    <article>
      <div class="project-entry">
        <span class="project-number" aria-hidden="true">0{index + 2}</span>
        <div class="project-identity">
          <p>{project.domain}</p>
          <h3 id={`${project.slug}-title`}>
            <a href={`/work/${project.slug}/`}>{project.name}</a>
          </h3>
        </div>
        <div class="project-context">
          <p>{project.distinction}</p>
          <div class="project-actions project-row-actions">
            {project.demoAvailable && (
              <a class="button button-primary" href={`#demo=${project.slug}`} data-demo-trigger={project.slug}>
                Try demo
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
              </a>
            )}
            <a class="button button-secondary" href={`/work/${project.slug}/`}>
              Read case study
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"></path></svg>
            </a>
            <a class="button button-secondary" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.name} repository`}>
              View repository
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg>
            </a>
          </div>
        </div>
        <a class="project-arrow" href={`/work/${project.slug}/`} aria-label={`Read ${project.name} case study`}>
          <svg viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"></path></svg>
        </a>
      </div>
    </article>
  ))}
</div>
