---
import DemoHost from '../components/DemoHost.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ahmed Hossam — Software Engineer',
  description = 'Ahmed Hossam — full-stack software engineer. Selected work in retail operations, automotive marketplaces, production finance, and inventory.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111516" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to portfolio</a>
    <slot />
    <DemoHost />
  </body>
</html>
