---
import ContactFooter from '../components/ContactFooter.astro';
import Hero from '../components/Hero.astro';
import Navigation from '../components/Navigation.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../content/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main id="main-content">
    <section class="studio" aria-label="Ahmed Hossam portfolio">
      <div class="studio-wrap">
        <Navigation />
        <Hero />
        <div class="section-heading" id="selected-work">
          <h2>Selected work <span>01—04</span></h2>
          <p>Four systems, built for real operations.</p>
        </div>
        <div class="project-cards">
          {projects.map((project, index) => (
            <ProjectCard project={project} index={index} />
          ))}
        </div>
        <ContactFooter />
      </div>
    </section>
  </main>
</BaseLayout>
