---
import CaseStudy from '../../components/CaseStudy.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import Navigation from '../../components/Navigation.astro';
import { projects, type ProjectContent } from '../../content/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../content/profile';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: ProjectContent;
}

const { project } = Astro.props;
const title = `${project.name} case study — ${profile.name}`;
const description = `${project.name}: ${project.distinction}`;
---

<BaseLayout title={title} description={description}>
  <div class="studio">
    <div class="studio-wrap">
      <Navigation />
      <main id="main-content" tabindex="-1" aria-label={`${project.name} case study`}>
        <CaseStudy project={project} />
      </main>
      <ContactFooter />
    </div>
  </div>
</BaseLayout>
